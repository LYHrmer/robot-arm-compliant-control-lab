<mujoco model="planar compliant arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint armature="0.04" damping="0.7" limited="true"/>
    <geom density="650" friction="0.9 0.08 0.01" rgba="0.22 0.48 0.85 1"/>
    <motor ctrllimited="true" ctrlrange="-40 40"/>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-90"/>
  </visual>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" pos="0 0 0.08" size="1.2 1.2 0.05"
          rgba="0.12 0.15 0.19 1" contype="0" conaffinity="0"/>
    <geom name="wall" type="box" pos="0.72 0 0.20" size="0.025 0.55 0.10"
          rgba="0.85 0.38 0.20 1" solref="0.008 1" solimp="0.95 0.99 0.002"/>

    <body name="base" pos="0 0 0.20">
      <geom type="cylinder" size="0.09 0.06" rgba="0.12 0.18 0.25 1"
            contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
        <geom type="capsule" fromto="0 0 0 0.45 0 0" size="0.035"
              contype="0" conaffinity="0"/>
        <body name="link2" pos="0.45 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
          <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.03"
                rgba="0.28 0.66 0.92 1" contype="0" conaffinity="0"/>
          <body name="end_effector" pos="0.35 0 0">
            <geom name="fingertip" type="sphere" size="0.045"
                  rgba="0.95 0.82 0.25 1" friction="0.45 0.05 0.005"/>
            <site name="ee_site" size="0.012" rgba="0.2 1 0.3 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder"/>
    <motor name="elbow_motor" joint="elbow"/>
  </actuator>
</mujoco>
